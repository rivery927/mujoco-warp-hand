<mujoco model="finger_v1">
  <compiler angle="degree" autolimits="true" inertiafromgeom="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint type="hinge" axis="0 1 0" damping="0.1"/>
    <geom  type="capsule" rgba="0.7 0.75 0.85 1"/>
    <position kp="100" forcerange="-1.39 1.39"/>
  </default>

  <worldbody>
    <light pos="0.2 0 0.5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.05" rgba="0.85 0.9 0.85 1"/>

    <!-- palm: 长方体, 长边沿 y (横向), 短边沿 x (厚度).
         palm 中心在 (0, 0, 0.15), 半边长 (x=0.02, y=0.04, z=0.015).
         所以 palm 占据 x in [-0.02, +0.02], 指头从 x=+0.02 伸出. -->
    <body name="palm" pos="0 0 0.15">
      <geom name="palm_geom" type="box" size="0.02 0.04 0.015"
            rgba="0.4 0.4 0.45 1" mass="0.08"/>

      <!-- proximal phalanx: 从 palm +x 边缘 (x=0.02) 伸出.
           让 MCP=0 时指头水平朝 +x. -->
      <body name="proximal" pos="0.02 0 0">
        <joint name="mcp" range="-10 90"/>
        <geom  name="proximal_geom"
               fromto="0 0 0 0.05 0 0"
               size="0.008"
               mass="0.04"/>

        <body name="distal" pos="0.05 0 0">
          <joint name="pip" range="0 110"/>
          <geom  name="distal_geom"
                 fromto="0 0 0 0.035 0 0"
                 size="0.007"
                 mass="0.04"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="mcp_act" joint="mcp" ctrlrange="-10 90"/>
    <position name="pip_act" joint="pip" ctrlrange="0 110"/>
  </actuator>
</mujoco>
